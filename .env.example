# ZyronByte AI Studio Environment Configuration

# Google Gemini API Key for Highlight Detection & Social Metadata
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 OAuth Credentials
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret

# Instagram Graph API Credentials
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Automation Preferences
AUTO_PUBLISH=false
CLIPS_PER_VIDEO=6
DAILY_PUBLISH_LIMIT=3
DEFAULT_CROP_MODE=blur_fill
